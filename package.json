{
  "name": "ham-rn",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "embed": "tsx scripts/embed.ts",
    "android": "pnpm embed && react-native run-android",
    "ios": "pnpm embed && react-native run-ios --simulator=\"iPhone 17 Pro\"",
    "lint": "eslint .",
    "start": "pnpm embed && react-native start",
    "test": "pnpm embed && jest",
    "bundle:android": "pnpm embed && mkdir -p build/android && react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/android/index.android.bundle --assets-dest build/android/res",
    "bundle:ios": "pnpm embed && mkdir -p build/ios && react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/ios/main.jsbundle --assets-dest build/ios",
    "deploy": "pnpm hot-updater deploy -i",
    "prepare": "husky"
  },
  "dependencies": {
    "@hot-updater/react-native": "0.31.0",
    "@preeternal/react-native-cookie-manager": "^6.3.0",
    "@react-native-community/cli-platform-android": "^20.1.0",
    "@types/color": "^3.0.6",
    "@types/react-native-md5": "^1.0.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "cheerio": "^1.2.0",
    "color": "^5.0.3",
    "eslint-plugin-react-hooks": "^6.1.1",
    "i18next": "^26.3.4",
    "jotai": "^2.16.2",
    "react": "^19.2.4",
    "react-i18next": "^16.5.3",
    "react-native": "~0.83.1",
    "react-native-md5": "^1.0.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.29.2",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@hot-updater/bare": "0.31.0",
    "@hot-updater/cloudflare": "0.31.0",
    "@react-native-community/cli": "20.1.3",
    "@react-native/babel-preset": "~0.83.1",
    "@react-native/eslint-config": "~0.83.1",
    "@react-native/eslint-plugin": "^0.80.3",
    "@react-native/metro-config": "~0.83.1",
    "@react-native/typescript-config": "~0.85.3",
    "@types/prettier": "^2.7.3",
    "@types/react": "^19.2.10",
    "@types/react-test-renderer": "^18.3.1",
    "babel-jest": "^29.7.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "hot-updater": "0.31.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "lint-staged": "^16.1.0",
    "prettier": "3.5.3",
    "react-test-renderer": "^19.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "wrangler": "^4.93.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "codegenConfig": {
    "name": "RNNativeModuleSpec",
    "type": "modules",
    "jsSrcsDir": "src/modules",
    "android": {
      "javaPackageName": "com.nowcent.ham.rn.nativemodule"
    },
    "ios": {
      "modulesProvider": {
        "NativeCasMobileLoginModule": "RNNativeCasMobileLoginModule",
        "NativeCasModule": "RNNativeCasModule",
        "NativeCommonModule": "RNNativeCommonModule",
        "NativeEducationModule": "RNNativeEducationModule",
        "NativeLog": "RNNativeLog",
        "NativeScoreCalcModule": "RNNativeScoreCalcModule"
      }
    }
  }
}
