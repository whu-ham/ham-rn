{
  "name": "ham-rn",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "embed": "tsx scripts/embed.ts",
    "android": "pnpm embed && react-native run-android",
    "ios": "pnpm embed && react-native run-ios --simulator=\"iPhone 17 Pro\"",
    "lint": "eslint .",
    "start": "pnpm embed && react-native start",
    "test": "pnpm embed && jest",
    "bundle:android": "pnpm embed && mkdir -p build/android && react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/android/index.android.bundle --assets-dest build/android/res",
    "bundle:ios": "pnpm embed && mkdir -p build/ios && react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/ios/main.jsbundle --assets-dest build/ios",
    "deploy": "pnpm hot-updater deploy -i",
    "prepare": "husky"
  },
  "dependencies": {
    "@hot-updater/react-native": "0.36.6",
    "@preeternal/react-native-cookie-manager": "^6.4.1",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@types/color": "^4.2.1",
    "@types/react-native-md5": "^1.0.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "cheerio": "^1.2.0",
    "color": "^5.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^26.4.2",
    "jotai": "^2.20.3",
    "react": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-native": "~0.87.1",
    "react-native-md5": "^1.0.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.29.2",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@hot-updater/bare": "0.36.8",
    "@hot-updater/cloudflare": "0.36.8",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "~0.87.1",
    "@react-native/eslint-config": "~0.87.1",
    "@react-native/eslint-plugin": "^0.87.1",
    "@react-native/jest-preset": "~0.87.1",
    "@react-native/metro-config": "~0.87.1",
    "@react-native/typescript-config": "~0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/prettier": "^3.0.0",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^30.5.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "hot-updater": "0.36.6",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.0",
    "prettier": "3.9.6",
    "react-test-renderer": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.129.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "codegenConfig": {
    "name": "RNNativeModuleSpec",
    "type": "modules",
    "jsSrcsDir": "src/modules",
    "android": {
      "javaPackageName": "com.nowcent.ham.rn.nativemodule"
    },
    "ios": {
      "modulesProvider": {
        "NativeCasMobileLoginModule": "RNNativeCasMobileLoginModule",
        "NativeCasModule": "RNNativeCasModule",
        "NativeCommonModule": "RNNativeCommonModule",
        "NativeEducationModule": "RNNativeEducationModule",
        "NativeLog": "RNNativeLog",
        "NativeScoreCalcModule": "RNNativeScoreCalcModule"
      }
    }
  },
  "pnpm": {
    "patchedDependencies": {
      "@hot-updater/react-native@0.36.6": "patches/@hot-updater__react-native@0.36.6.patch",
      "react-native-webview@14.0.1": "patches/react-native-webview@14.0.1.patch"
    }
  }
}
